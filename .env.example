# Fill only on your machine/server; never commit .env.
MODEL_PROVIDER=openai
MODEL_BASE_URL=https://api.openai.com
MODEL_NAME=gpt-4.1-mini
MODEL_API_KEY=
# For DashScope: MODEL_PROVIDER=dashscope and set this key.
DASHSCOPE_API_KEY=
SEARCH_API_KEY=
PEXELS_API_KEY=
RAG_ENABLED=false
RAG_CLOUD_ENABLED=false
EXTENDED_TOOLS_ENABLED=false
TERMINAL_ENABLED=false

# Optional local services (enabled on Turing)
MCP_ENABLED=false
MCP_URL=http://127.0.0.1:18127
EMBEDDING_BASE_URL=http://127.0.0.1:18128
EMBEDDING_API_KEY=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_INDEX_DIR=tmp/rag

# Public non-commercial planning evidence; no API key required
PLANNING_LIVE_ENABLED=false

# Optional Amap Web service key. Set only in private server configuration.
AMAP_API_KEY=

# Optional exact release commit (or commit-dirty). Unknown when unset.
APP_BUILD_REVISION=

# Optional pi Coding Agent (Node >=22.19; npm ci --ignore-scripts in coding-agent/)
CODING_ENABLED=false
CODING_NODE=node
CODING_ENTRY=coding-agent/src/main.mjs
CODING_SHELL_ENABLED=false
# Optional dedicated model. Blank key/base/name reuse app.model settings.
# Use the full provider base URL (OpenAI usually ends in /v1).
CODING_MODEL_API=openai-completions
CODING_MODEL_PROVIDER=custom
CODING_MODEL_API_KEY=
CODING_MODEL_BASE_URL=
CODING_MODEL_NAME=

# Optional account gateway (local launcher prompts for password on first start)
ACCESS_USER=admin
ACCESS_PASSWORD=
# TLS reverse proxy: set exact origin and secure cookies together.
PUBLIC_ORIGIN=
SESSION_COOKIE_SECURE=false
# Optional base64-encoded 32-byte key; otherwise tmp/model-profiles/master.key is created.
MODEL_PROFILE_MASTER_KEY=
